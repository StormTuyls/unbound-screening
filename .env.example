# Alle omgevingsvariabelen van de app. Kopieer naar .env.local (lokaal) of naar
# de omgeving van de server, en vul in. Nooit echte waarden in dit bestand.

# --- verplicht -----------------------------------------------------------------

# De databank, als de rol intake_server. Lokaal: de stack op poort 54322.
DATABASE_URL=postgresql://intake_server:WACHTWOORD@127.0.0.1:54322/postgres
# Het wachtwoord dat scripts/db-local.ts op intake_server zet.
INTAKE_SERVER_PASSWORD=
# Het publieke adres van de app, voor links in mails. Lokaal http://localhost:3100.
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Claude, voor het intakegesprek en het lezen van documenten.
ANTHROPIC_API_KEY=
# Geheim voor /api/cron/retention (Bearer). Lang en willekeurig.
CRON_SECRET=

# --- mail (herstellinks en uitnodigingen) --------------------------------------

# Zonder SMTP_URL gaat er geen mail weg: een uitnodiging toont dan de link op
# het scherm, en "wachtwoord vergeten" werkt niet. Lokaal vangt Mailpit alles op.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=unbound <no-reply@voorbeeld.be>

# --- opslag --------------------------------------------------------------------

# De documentenmap. Op een server: een map op een versleutelde schijf, mee in de
# backup. Lokaal standaard ./data/documents.
DOCUMENTS_DIR=

# --- bewaartermijn (wat de atleet leest bij zijn toestemming) -------------------

# indefinite of until_date. Zie lib/intake/retention.ts.
RETENTION_MODE=
RETENTION_MONTHS=
RETENTION_BASIS=
PRACTICE_LOCALE=nl

# --- bouwen ---------------------------------------------------------------------

# De echte afkapwaarden staan niet in git. Bij het bouwen schrijft
# scripts/afkapwaarden-schrijven.ts ze uit deze base64; lokaal volstaat een
# kopie van lib/screening/afkapwaarden.voorbeeld.ts.
AFKAPWAARDEN_B64=

# --- alleen voor scripts en testen ---------------------------------------------

# Admin-verbinding voor seeds, testen en create-coach. Nooit in de app.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- optioneel -----------------------------------------------------------------

# Spraak naar tekst in het intakegesprek.
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=
# Notion-koppeling (commerciële laag). Leeg laten = uit.
NOTION_API_KEY=
NOTION_API_VERSION=
NOTION_ATHLETES_DB=
NOTION_INVOICES_DB=
NOTION_PARENT_PAGE_ID=
NOTION_TASKS_DB=

# Eenmalig bij de verhuizing, voor scripts/storage-to-disk.ts:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
